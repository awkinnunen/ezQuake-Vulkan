+ X(enable,"Enabled","0",0,1,1,1,"Enable the Vulkan visual style") \
+ X(detail,"Fine detail","1",0,1,.05,1,"Keep large patterns, reduce grain") \
+ X(pattern,"Pattern scale","2",0,5,.25,1,"Mip levels used for broad patterns") \
+ X(contrast,"Texture contrast","1",.2,1.5,.05,1,"Contrast around each broad pattern") \
+ X(saturation,"Saturation","1",0,1.5,.05,1,"World colour saturation") \
+ X(distance,"Distance smoothing","0",0,2,.1,1,"Gradual extra smoothing at distance") \
+ X(floor,"Floor colour","3",0,13,1,1,"Original Quake palette colour") \
+ X(wall,"Wall colour","2",0,13,1,1,"Original Quake palette colour") \
+ X(tint,"Surface tint","0",0,1,.05,1,"Blend floor/wall material colours") \
+ X(light,"Light response","0",0,2,1,2,"0 original  1 gradient  2 soft cel") \
+ X(lightmix,"Style blend","0",0,1,.05,2,"Blend styled and original lighting") \
+ X(worldlight,"World lighting","1",0,1,1,2,"Apply response to baked lighting") \
+ X(modellight,"Model lighting","1",0,1,1,2,"Apply response to ordinary models") \
+ X(shadow,"Shadow level","0.2",0,.7,.025,2,"Styled shadow brightness") \
+ X(midtone,"Midtone level","0.55",.1,1,.025,2,"Styled midtone brightness") \
+ X(highlight,"Highlight level","1",.5,1.5,.025,2,"Styled highlight brightness") \
+ X(bands,"Cel bands","4",2,8,1,2,"Number of lighting bands") \
+ X(softness,"Band softness","0.3",.05,1,.05,2,"Smooth transitions between bands") \
+ X(warmth,"Warm / cool","0",-.2,.2,.025,2,"Subtle light and shadow hue shift") \
+ X(rim,"Player rim","0",0,.2,.01,3,"Surface light; disabled on powerups") \
+ X(rimwidth,"Rim width","3",1,8,.25,3,"Higher values narrow the rim") \
+ X(rimup,"Upward bias","0.65",0,1,.05,3,"Favour upward facing surface normals") \
+ X(rimteam,"Team tint","0.15",0,.3,.025,3,"Very slight player shirt colour") \
+ X(edgewidth,"World edge width","1",.5,3,.1,3,"Screen-space world line width") \
+ X(edgestrength,"World edge opacity","1",0,1,.05,3,"Blend world lines into the scene") \
