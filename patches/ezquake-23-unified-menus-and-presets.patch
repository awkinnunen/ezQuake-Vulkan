+ else if(!strcmp(cmd,"browse"))OpenPresets();
+ else if(!strcmp(cmd,"preview")){if(!browsing)OpenPresets();for(i=0;i<presetCount;++i)if(!strcmp(files[i].name,Cmd_Argv(2))){presets.marked=presetStart+i;PreviewFile(i);break;}}
