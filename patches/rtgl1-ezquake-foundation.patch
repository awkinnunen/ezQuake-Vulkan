+// RT-00, OpenAI Codex: explicit device binding for the ezQuake adapter.
+// Additive ABI; call before instance creation, from the renderer thread.
+static uint8_t ezqDeviceUuid[VK_UUID_SIZE] = {};
+static bool ezqDeviceSelected = false;
+extern "C" RGAPI uint32_t RGCONV rgEzqGetApiVersion(void) { return 1; }
+extern "C" RGAPI RgBool32 RGCONV rgEzqSelectDevice(const uint8_t* uuid)
+{
+    if (!uuid) return RG_FALSE;
