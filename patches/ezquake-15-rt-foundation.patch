diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,6 +10,10 @@
 option(RENDERER_MODERN_OPENGL   "Enable modern OpenGL renderer"               ON)
 option(RENDERER_CLASSIC_OPENGL  "Enable classic OpenGL renderer"              ON)
 option(RENDERER_VULKAN          "Enable experimental Vulkan renderer"         OFF)
+option(RENDERER_RTGL1           "Build experimental RTGL1 adapter and diagnostic harness" OFF)
+if(RENDERER_RTGL1 AND (NOT WIN32 OR NOT RENDERER_VULKAN))
+    message(FATAL_ERROR "RTGL1 currently requires Windows and the Vulkan fallback renderer.")
+endif()
 option(DEBUG_MEMORY_ALLOCATIONS "Enable debug prints for memory allocations" OFF)
 option(ANTILAG                  "Enable antilag 1 prototype protocol extensions (client-side)" ON)
 option(ENABLE_SANDBOX           "Enables application sandboxing (macOS)"      ON)
@@ -1048,6 +1052,14 @@
     target_link_libraries(ezquake PRIVATE Vulkan::Vulkan)
 endif()
 
+if(RENDERER_RTGL1)
+    add_library(ezquake_rt_runtime STATIC src/rt/rt_probe.c src/rt/rt_api.c)
+    target_include_directories(ezquake_rt_runtime PUBLIC src/rt)
+    target_link_libraries(ezquake_rt_runtime PUBLIC Vulkan::Vulkan Dep::SDL3 Dep::Jansson bcrypt)
+    add_executable(ezquake-rt-harness src/rt/rt_harness.c)
+    target_link_libraries(ezquake-rt-harness PRIVATE ezquake_rt_runtime)
+endif()
+
 if(MATH)
     target_link_libraries(ezquake PRIVATE ${MATH})
 endif()
